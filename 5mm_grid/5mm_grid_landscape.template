{
    "name": "5mm grid",
    "author": "Kalamart",
    "iconData": "",
    "templateVersion": "1.0.0",
    "formatVersion": 1,
    "categories": ["Productivity", "Note-taking"],
    "labels": ["Meetings"],
    "orientation": "landscape",
    "constants": [
        {"gridSize": 44.375}
    ],
    "items": [
        {
            "type": "group",
            "boundingBox": {
                "x": 0,
                "y": 0,
                "width": "gridSize",
                "height": "gridSize"
            },
            "repeat": {
                "rows": "infinite",
                "columns": "infinite"
            },
            "children": [
                {
                    "type": "path",
                    "strokeWidth": 1,
                    "data": [
                        "M", 0, 0, "L", "parentWidth", 0
                    ]
                },
                {
                    "type": "path",
                    "strokeWidth": 1,
                    "data": [
                        "M", 0, 0, "L", 0, "parentHeight"
                    ]
                }
            ]
        }
    ]
}

