{
    "name": "Checklist",
    "author": "Kalamart",
    "iconData": "",
    "templateVersion": "1.0.0",
    "formatVersion": 1,
    "categories": ["Productivity"],
    "labels": ["Meetings"],
    "orientation": "landscape",
    "constants": [
        {"lineHeight": 71},
        {"squareSize": 35.5},
        {"leftMargin": 133},
        {"rightMargin": 71},
        {"titleMargin": "templateWidth/5"}
    ],
    "items": [
        {
            "type": "path",
            "data": [
                "M", "titleMargin", 140,
                "L", "templateWidth - titleMargin", 140
            ]
        },
        {
            "type": "group",
            "boundingBox": {
                "x": "leftMargin",
                "y": 171,
                "width": "templateWidth-leftMargin-rightMargin",
                "height": "lineHeight"
            },
            "repeat": {
                "rows": "down"
            },
            "children": [
                {
                    "type": "path",
                    "strokeWidth": 2,
                    "data": [
                        "M", 0, "parentHeight-squareSize",
                        "L", 0, "parentHeight",
                        "L", "squareSize", "parentHeight",
                        "L", "squareSize", "parentHeight-squareSize",
                        "Z"
                    ]
                },
                {
                    "type": "path",
                    "data": [
                        "M", "squareSize+17.75", "parentHeight",
                        "L", "parentWidth", "parentHeight"
                    ]
                }
            ]
        }
    ]
}
