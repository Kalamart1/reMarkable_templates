{
    "name": "Tablet weaving",
    "author": "Kalamart",
    "iconData": "",
    "templateVersion": "1.0.0",
    "formatVersion": 1,
    "categories": ["Community"],
    "labels": ["Meetings"],
    "orientation": "landscape",
    "constants": [
        {"gridSize": 35.5},
        {"previewWidth": "gridSize*2/3"},
        {"separatorWidth": "2*gridSize"},
        {"separator": "(templateWidth-separatorWidth) * 3/5 + separatorWidth/2"}
    ],
    "items": [
        {
            "type": "group",
            "boundingBox": {
                "x": "separator - separatorWidth/2 - gridSize",
                "y": "gridSize",
                "width": "gridSize",
                "height": "gridSize"
            },
            "repeat": {
                "rows": "infinite",
                "columns": "left"
            },
            "children": [
                {
                    "type": "path",
                    "data": [
                        "M", 0, "parentHeight", "L", "parentWidth", "parentHeight"
                    ]
                },
                {
                    "type": "path",
                    "data": [
                        "M", "parentWidth", 0, "L", "parentWidth", "parentHeight"
                    ]
                }
            ]
        },
        {
            "type": "group",
            "boundingBox": {
                "x": "separator + separatorWidth/2",
                "y": "gridSize/2",
                "width": "previewWidth",
                "height": "gridSize"
            },
            "repeat": {
                "rows": "infinite",
                "columns": "right"
            },
            "children": [
                {
                    "type": "path",
                    "data": [
                        "M", 0, 0, "L", "parentWidth", "gridSize"
                    ]
                },
                {
                    "type": "path",
                    "data": [
                        "M", 0, "gridSize", "L", "parentWidth", 0
                    ]
                },
                {
                    "type": "path",
                    "data": [
                        "M", 0, 0, "L", 0, "parentHeight"
                    ]
                }
            ]
        }
    ]
}


